# ==============================================================================
# RAMAN SWEET & LUXURY PÂTISSERIE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file to .env and configure with production credentials.
# NEVER commit real credentials to version control.

# 1. Neon PostgreSQL Database (Pooled Connection String)
# Example: postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 2. Server-Side Authentication
# Generate a high-entropy 256-bit random key: openssl rand -base64 32
JWT_SECRET="generate_a_secure_random_jwt_secret_key_for_production"

# 3. ImageKit Media Storage & Global CDN
IMAGEKIT_PUBLIC_KEY="public_placeholder_key"
IMAGEKIT_PRIVATE_KEY="private_placeholder_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# 4. Production Application URL (For Canonical Links, OpenGraph & Sitemaps)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 5. Initial Admin Bootstrap Credentials (For prisma/seed.js)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"
